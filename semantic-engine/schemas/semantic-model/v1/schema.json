{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1",
  "title": "Bruin Semantic Model",
  "type": "object",
  "required": ["name", "source"],
  "properties": {
    "schema": {
      "comment": "v1 is canonical; the getbruin.com URL is the legacy dac identifier, accepted for backward compatibility.",
      "enum": [
        "v1",
        "https://getbruin.com/schemas/dac/semantic-model/v1"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "primary_key": {
      "type": "string"
    },
    "joins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/join"
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model_check"
      }
    }
  },
  "patternProperties": {
    "^x-": true
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["table"],
      "properties": {
        "table": {
          "type": "string",
          "minLength": 1
        },
        "connection": {
          "type": "string",
          "minLength": 1
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "note": {
      "type": "object",
      "required": ["id", "dimensions"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noteDimension"
          }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "noteDimension": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["select", "date", "number", "boolean", "text"],
          "default": "select"
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "Whether this dimension must be selected when creating a note."
        },
        "multiselect": {
          "type": "boolean",
          "default": false,
          "description": "Whether the note may target multiple values of this dimension."
        }
      },
      "if": {
        "required": ["type"],
        "properties": {
          "type": { "const": "boolean" }
        }
      },
      "then": {
        "properties": {
          "multiselect": { "const": false }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "join": {
      "type": "object",
      "required": ["name", "relationship"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "enum": ["one_to_one", "many_to_one", "one_to_many", "many_to_many"]
        },
        "foreign_key": {
          "type": "string"
        },
        "target_key": {
          "type": "string"
        },
        "sql": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "dimension": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "enum": ["string", "number", "boolean", "time"]
        },
        "expression": {
          "type": "string"
        },
        "granularities": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hidden": {
          "type": "boolean"
        },
        "group": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["name", "expression"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "filter": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        },
        "group": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "format": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["number", "currency", "percentage", "decimal"]
        },
        "currency": {
          "type": "string"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["running_total", "lag", "lead", "rank", "percent_of_total"]
        },
        "order_by": {
          "type": "string"
        },
        "partition_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": ["name", "filter"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "filter": {
          "type": "string",
          "minLength": 1
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "check": {
      "comment": "Built-in quality check on a dimension or metric. Supported names are validated by the engine.",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "value": {}
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "model_check": {
      "comment": "Custom model-level quality check expressed as a semantic query; value and count are mutually exclusive.",
      "type": "object",
      "required": ["name", "query"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/query"
        },
        "value": {},
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimension_ref"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filter"
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sort": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sort_ref"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "dimension_ref": {
      "comment": "Either the name:granularity shorthand or an object.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "granularity": {
              "type": "string"
            }
          },
          "patternProperties": {
            "^x-": true
          },
          "additionalProperties": false
        }
      ]
    },
    "sort_ref": {
      "comment": "Either the name:direction shorthand or an object.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "direction": {
              "enum": ["asc", "desc"]
            }
          },
          "patternProperties": {
            "^x-": true
          },
          "additionalProperties": false
        }
      ]
    },
    "filter": {
      "type": "object",
      "properties": {
        "dimension": {
          "type": "string"
        },
        "operator": {
          "enum": ["equals", "not_equals", "gt", "gte", "lt", "lte", "in", "not_in", "between", "is_null", "is_not_null"]
        },
        "value": {},
        "expression": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    }
  }
}
